# Public origin only (no /mcp path). Example: https://jw-mcp.example.com
# Must be served on port 443. Claude.ai connectors never connect to other ports.
MCP_BASE_URL=https://jw-mcp.example.com

# Access key users type on the login page. At least 16 characters.
# Generate one with: openssl rand -hex 32
MCP_AUTH_SECRET=your-secret-here-min-16-chars

# Leave true for Claude.ai, ChatGPT, and Grok connectors.
# HTTP mode with auth off is loopback-only. Do not set MCP_AUTH=false in Docker.
MCP_AUTH=true

MCP_PORT=8080

# Set true only when exactly one proxy sits in front of the server and sets or
# appends the real client IP in X-Forwarded-For (Caddy, nginx, or the Cloudflare
# Tunnel below). The server trusts one hop only. Leave unset otherwise.
# MCP_TRUST_PROXY=true

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel).
# Start with: docker compose --profile tunnel up -d
# CLOUDFLARE_TUNNEL_TOKEN=
